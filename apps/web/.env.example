# Base de datos local (PostgreSQL 16 de Homebrew). Los tests usan mando_test y el E2E mando_e2e, que se recrean solos.
DATABASE_URL=postgres://localhost:5432/mando_dev
# 1 activa las rutas de desarrollo (/api/dev/*: siembra, reinicio y reloj de pruebas) y la página /sistema. Nunca en producción.
DEV_ENDPOINTS=1

# Solo desarrollo: IPs o nombres de la red local que pueden abrir `pnpm dev` (p. ej. el teléfono), separados por comas.
ALLOWED_DEV_ORIGINS=
